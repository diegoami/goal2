{
  "shell": "/bin/sh",
  "plugins": [
    "-opencode.warming"
  ],
  "providers": {
    "t72-metadata-only": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:9/NEVER-CALLED"
      },
      "models": {
        "initial": {
          "name": "Metadata fixture",
          "family": "minimax",
          "limit": {
            "context": 10000,
            "output": 1000
          }
        }
      }
    }
  }
}
